{
  "name": "momentra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/prepare-sqlite-db.mjs && prisma migrate deploy && next start",
    "lint": "eslint .",
    "seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@prisma/client": "^5.22.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.56.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.6"
  }
}
